rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // All form submissions are validated, rate-limited, and written server-side
    // via the Firebase Admin SDK (/api/submissions and /api/contact-form).
    // Lock down all direct client read/write access by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
