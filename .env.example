# Optional: Personal access token for /api/typeform-handler Responses API lookup
TYPEFORM_TOKEN=

# Optional: Firebase Firestore (Admin SDK) for recording all form submissions
# Option A (easiest on Vercel): paste the entire downloaded service account JSON on one line
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B: set individual service account fields instead of FIREBASE_SERVICE_ACCOUNT_JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: Firestore collection name (defaults to "form_submissions")
FIREBASE_COLLECTION=form_submissions
